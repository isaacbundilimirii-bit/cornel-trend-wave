# ===== Next Wave Trends backend env =====
# Copy to .env and fill in. Render sets these as environment variables.

# Server
PORT=8090
NODE_ENV=development

# Database (Render provides DATABASE_URL for the postgres addon)
DATABASE_URL=postgres://user:pass@localhost:5432/twave

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# Bootstrap admin (created on first migrate:seed if not exists)
ADMIN_PHONE=0712000000
ADMIN_PASSWORD=admin12345
ADMIN_NAME=Shop Admin

# ===== Africa's Talking (SMS / OTP) =====
# Get keys at https://account.africastalking.com. Use sandbox for dev.
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=NextWave
# If blank, OTP is returned in the API response + server logs (demo mode).

# ===== M-Pesa Daraja STK push =====
# Get credentials at https://developer.safaricom.co.ke
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-domain.onrender.com/api/payments/mpesa/callback
# Type: 'stk' (Daraja STK push) or 'manual' (show till/paybill to customer)
MPESA_MODE=manual
# Used when MPESA_MODE=manual (admin-set fallback shown on checkout)
MPESA_TILL_NUMBER=
MPESA_BUSINESS_NAME=Next Wave Trends

# ===== Email (dev = MailHog, cloud = Resend OR SMTP) =====
# Dev: point SMTP_HOST at MailHog (no user/pass needed). Emails appear at http://localhost:8025
#   docker run -d --name mailhog -p 8025:8025 -p 1025:1025 mailhog/mailhog
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=hello@nextwavetrends.co.ke
CONTACT_NOTIFY_EMAIL=sales@nextwavetrends.co.ke

# Resend (cloud, https://resend.com) — takes priority over SMTP if set.
# Get RESEND_API_KEY from your Resend dashboard. For the 'from' address:
#   - Without a verified domain, use Resend's shared address: onboarding@resend.dev
#   - With a verified domain (nextwavetrends.co.ke), use Next Wave Trends <hello@nextwavetrends.co.ke>
RESEND_API_KEY=
RESEND_FROM=Next Wave Trends <onboarding@resend.dev>

# Public site URL used in email links (e.g. the "Start shopping" button)
PUBLIC_SITE_URL=http://localhost:8090

# ===== Media Storage (Multi-Provider) =====
# Choose: 'seaweedfs' (local dev), 's3' (production), 'cloudinary' (images only)
# For image optimization alongside S3/SeaweedFS, set IMAGE_PROVIDER=cloudinary
STORAGE_PROVIDER=seaweedfs
IMAGE_PROVIDER=
MEDIA_BASE_URL=http://localhost:8888
MAX_FILE_SIZE=10485760

# ===== SeaweedFS (Local Development) =====
# Started automatically via: docker compose up -d
# Master: assigns file IDs. Volume: stores files. Filer: path-based access.
SEAWEEDFS_MASTER_URL=http://localhost:9333
SEAWEEDFS_VOLUME_URL=http://localhost:8080
SEAWEEDFS_FILER_URL=http://localhost:8888
# In Docker Compose, use service names:
#   SEAWEEDFS_MASTER_URL=http://seaweedfs-master:9333
#   SEAWEEDFS_VOLUME_URL=http://seaweedfs-volume:8080
#   SEAWEEDFS_FILER_URL=http://seaweedfs-filer:8888

# ===== AWS S3 (Production) =====
# Get credentials at https://console.aws.amazon.com/iam/
# Create a bucket, then set these env vars.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=
# For non-AWS S3-compatible (MinIO, DigitalOcean Spaces, etc.):
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false

# ===== Cloudinary (Image Processing & Delivery) =====
# Get credentials at https://cloudinary.com/console
# Used for: image optimization, resizing, format conversion, CDN delivery
# Set IMAGE_PROVIDER=cloudinary to enable alongside primary storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
